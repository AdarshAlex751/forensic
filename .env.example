# Copy to .env (never commit .env). Restart the backend and the frontend after editing it.

# Language model for the evidence, analysis and investigator slices (Groq).
GROQ_API_KEY=
# Optional: force the investigator's models. Leave empty to auto-pick one this key can use.
INVESTIGATOR_LEAD_MODEL=
INVESTIGATOR_SUBAGENT_MODEL=
# Optional: the model for the Feedback page's questions. Leave empty for the default, openai/gpt-oss-120b.
FEEDBACK_MODEL=

# Scene slice: Matterport (inside tour), Vexcel (aerial), CoStar (property data).
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
VEXCEL_API_KEY=
COSTAR_API_KEY=
# Read by the browser (VITE_ prefix): the Matterport model and SDK key.
VITE_MATTERPORT_MODEL_ID=
VITE_MATTERPORT_SDK_KEY=

# true = use the slice's real output in data/<slice>/, false = use its fake/ files. All four true for the demo.
USE_REAL_EVIDENCE=false
USE_REAL_SCENE=false
USE_REAL_ANALYSIS=false
USE_REAL_INVESTIGATOR=false
